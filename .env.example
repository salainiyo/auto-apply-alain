# Copy this file to .env and fill in the values.
# ============================================================
# auto-apply-alain — environment variables
# ALL sensitive info lives in .env. Never commit .env.
# ============================================================

APP_NAME=auto-apply-alain
FRONTEND_URL=http://localhost:5173

SECRET_KEY=change-me-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Docker: host is the compose service name "postgres" on port 5432
# Local dev: localhost:5433 (container maps 5433->5432)
DATABASE_URL=postgresql+asyncpg://alain:changepassword@localhost:5433/auto_apply
DATABASE_SYNC_URL=postgresql://alain:changepassword@localhost:5433/auto_apply

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_URL=redis://localhost:6379/1

# Gmail app password: enable 2FA, then myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=
EMAILS_FROM=your@gmail.com

# Google AI Studio: aistudio.google.com -> Get API key
GEMINI_API_KEY=

# Remotive, RemoteOK, Arbeitnow: free, no API key required
